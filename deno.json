{
  "version": "0.1.0",
  "imports": { "yaml": "npm:yaml@2.8.1" },
  "tasks": {
    "mci": "deno run --allow-run=deno scripts/task.ts mci",
    "check": "deno check src/main.ts scripts/task.ts tests/*.ts",
    "test": "deno run --allow-run=deno scripts/task.ts test",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test",
    "demo": "deno task mci run examples/basic.yml --job check",
    "compile": "deno run --allow-run=deno scripts/task.ts compile"
  },
  "compilerOptions": { "strict": true, "noUncheckedIndexedAccess": true },
  "fmt": { "lineWidth": 90 },
  "exclude": [".mci/", "demos/", "dist/"]
}
